@misc{gupta_impact_2026,
	title = {Impact of {UX} Design on Employee Productivity A Literature Based study},
	url = {https://www.ssrn.com/abstract=6438239},
	doi = {10.2139/ssrn.6438239},
	abstract = {User experience ({UX}) design has become an essential component of modern digital workplaces, influencing how employees interact with organizational systems and tools. As workplaces increasingly rely on digital platforms for communication, task management, and administrative processes, the quality of interface design plays a significant role in employee efficiency and productivity. This study examines the relationship between {UX} design and employee productivity through a review of existing academic literature. The research analyzes five scholarly studies focusing on visual ergonomics, user-centered design, usability testing, and {UX} optimization in workplace applications such as {HR} systems, attendance platforms, and digital collaboration tools. Findings from the literature indicate that effective {UX} design contributes to reduced human errors, faster task completion, improved system usability, and higher employee satisfaction. Additionally, user-centered interfaces support better learning outcomes and smoother administrative workflows. However, challenges remain in measuring productivity outcomes and generalizing findings across industries. Overall, the study highlights that investing in well-designed {UX} systems can significantly enhance workplace efficiency and employee performance in modern organizations.},
	publisher = {{SSRN}},
	author = {Gupta, Gauree},
	urldate = {2026-06-29},
	date = {2026},
	file = {PDF:/home/kirby/Zotero/storage/ZR8H7HST/Gupta - 2026 - Impact of UX Design on Employee Productivity A Literature Based study.pdf:application/pdf},
}

@article{manza-diaz_gestion_2025,
	title = {La gestión administrativa apoyada con herramientas tecnológicas emergentes},
	volume = {7},
	rights = {https://creativecommons.org/licenses/by-nc-sa/4.0},
	issn = {2739-0039},
	url = {https://iieakoinonia.org/ojs3/index.php/gestioep/article/view/322},
	doi = {10.35381/gep.v7i13.322},
	abstract = {El artículo tuvo como objetivo evaluar el impacto de la implementación de herramientas tecnológicas emergentes en la gestión administrativa de una organización. Metodológicamente, el estudio adoptó un diseño cuasiexperimental con un grupo experimental y un grupo de control. Se seleccionaron dos grupos de empresas del sector público. El grupo experimental adoptó el uso de las herramientas tecnológicas, mientras que el grupo de control mantuvo su sistema tradicional de gestión. Como técnicas, se emplearon encuestas y análisis de indicadores de desempeño administrativo. Las mediciones se realizaron antes y después de la implementación de las tecnologías, utilizando una escala Likert. Los resultados indicaron que el grupo experimental observó mejoras significativas en varios aspectos de la gestión administrativa en comparación con el grupo control. Como conclusión, la satisfacción de los empleados también aumentó debido a la simplificación de procesos administrativos y la eliminación de tareas repetitivas gracias a la automatización.},
	pages = {4--21},
	number = {13},
	journaltitle = {Gestio et Productio. Revista Electrónica de Ciencias Gerenciales},
	shortjournal = {Gest. et Pro.},
	author = {Manza-Diaz, Hildebrandt Grover and Coronado-Proaño, Carmen Cecilia and Esteves-Fajardo, Zila Isabel},
	urldate = {2026-06-29},
	date = {2025-07-01},
	file = {Texto completo:/home/kirby/Zotero/storage/K6538BJY/Manza-Diaz et al. - 2025 - La gestión administrativa apoyada con herramientas tecnológicas emergentes.pdf:application/pdf},
}


